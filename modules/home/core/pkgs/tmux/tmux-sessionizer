#!/usr/bin/env bash
set -euo pipefail

if (( $# > 1 )); then
    echo 'Usage: tmux-sessionizer [project-directory]' >&2
    exit 2
fi

if (( $# == 1 )); then
    selected=$1
else
    root="$HOME/projects"
    [[ -d "$root" ]] || exit 0
    # Keep top-level directories and nested repositories, including worktrees.
    # NUL delimiters preserve spaces and other shell characters in paths.
    if ! IFS= read -r -d '' selected < <(
        {
            find "$root" -mindepth 1 -maxdepth 1 -type d -print0
            find "$root" -mindepth 1 -maxdepth 3 \
                -type d \( -name node_modules -o -name .git -o -name dist -o -name build \) -prune \
                -o -type d -exec test -e '{}/.git' \; -print0
        } | sort -zu | fzf --read0 --print0
    ); then
        exit 0
    fi
fi

[[ -n "$selected" ]] || exit 0
# Physical paths give symlink aliases the same identity as their project.
if ! IFS= read -r -d '' selected < <(CDPATH='' cd -P -- "$selected" && printf '%s\0' "$PWD"); then
    echo 'tmux-sessionizer: project directory is not accessible' >&2
    exit 1
fi

label=$(printf '%s' "${selected##*/}" | LC_ALL=C tr -cs 'a-zA-Z0-9_-' '_')
fingerprint=$(printf '%s' "$selected" | sha256sum)
# A readable name plus a stable path hash avoids duplicate-basename collisions.
session="${label:0:40}-${fingerprint:0:12}"

# Ask the selected tmux server directly. Other servers/processes are irrelevant.
if ! tmux has-session -t "=$session" 2>/dev/null; then
    # Another invocation may have created it after has-session returned.
    tmux new-session -d -s "$session" -c "$selected" || tmux has-session -t "=$session"
fi

if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "=$session"
else
    exec tmux attach-session -t "=$session"
fi
